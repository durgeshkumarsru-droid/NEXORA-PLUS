import { useEffect, useMemo, useState } from 'react'
import { supabase } from './supabase'
import LinkVideoStudio from './LinkVideoStudio'

type Movie = {
  id: string
  title: string
  slug: string
  description: string | null
  poster_url: string | null
  video_url: string | null
  release_year: number | null
  original_language: string | null
  maturity_rating: string | null
  duration_minutes: number | null
  backdrop_url: string | null
  content_type: string
  is_published: boolean
  rights_verified: boolean
}

type Season = {
  id: string
  content_id: string
  season_number: number
  title: string
}

type AudioTrack = {
  id: string
  content_id: string | null
  episode_id: string | null
  language_code: string
  language_name: string
  audio_url: string
  source_type: string
  is_published: boolean
}

type Episode = {
  id: string
  season_id: string
  episode_number: number
  title: string
  description: string | null
  duration_minutes: number | null
  video_url: string | null
  poster_url: string | null
  is_published: boolean
}

const emptyForm = {
  title: '',
  slug: '',
  description: '',
  poster_url: '',
  video_url: '',
  release_year: '',
  original_language: '',
  maturity_rating: 'U/A 13+',
  duration_minutes: '',
  backdrop_url: '',
  content_type: 'movie',
}

const navigation = [
  { name: 'Overview', icon: '◫', group: 'WORKSPACE' },
  { name: 'Content Studio', icon: '＋', group: 'WORKSPACE' },
  { name: 'Content Library', icon: '▤', group: 'WORKSPACE' },
  { name: 'Link Video Studio', icon: '↗', group: 'WORKSPACE' },
  { name: 'Series Studio', icon: '▣', group: 'WORKSPACE' },
  { name: 'Audio & Dubbing', icon: '♫', group: 'WORKSPACE' },
  { name: 'Analytics', icon: '▥', group: 'INSIGHTS' },
  { name: 'Users', icon: '♙', group: 'MANAGEMENT' },
  { name: 'Subscriptions', icon: '◇', group: 'MANAGEMENT' },
  { name: 'Support Inbox', icon: '✉', group: 'MANAGEMENT' },
  { name: 'Settings', icon: '⚙', group: 'SYSTEM' },
]

export default function AdminPanel({ onBack }: { onBack?: () => void }) {
  const [movies, setMovies] = useState<Movie[]>([])
  const [message, setMessage] = useState('')
  const [loading, setLoading] = useState(false)
  const [editingId, setEditingId] = useState<string | null>(null)
  const [form, setForm] = useState(emptyForm)
  const [posterFile, setPosterFile] = useState<File | null>(null)
  const [videoFile, setVideoFile] = useState<File | null>(null)
  const [tickets, setTickets] = useState<any[]>([])
  const [replies, setReplies] = useState<Record<string, string>>({})
  const [supportLoading, setSupportLoading] = useState(false)
  const [activeTab, setActiveTab] = useState('Overview')
  const [search, setSearch] = useState('')
  const [selectedSeriesId, setSelectedSeriesId] = useState('')
  const [seasons, setSeasons] = useState<Season[]>([])
  const [selectedSeasonId, setSelectedSeasonId] = useState('')
  const [episodes, setEpisodes] = useState<Episode[]>([])
  const [seasonTitle, setSeasonTitle] = useState('')
  const [seasonNumber, setSeasonNumber] = useState('1')
  const [editingSeasonId, setEditingSeasonId] = useState<string | null>(null)
  const [episodeTitle, setEpisodeTitle] = useState('')
  const [episodeNumber, setEpisodeNumber] = useState('1')
  const [episodeDescription, setEpisodeDescription] = useState('')
  const [episodeDuration, setEpisodeDuration] = useState('')
  const [editingEpisodeId, setEditingEpisodeId] = useState<string | null>(null)
  const [episodeVideoFile, setEpisodeVideoFile] = useState<File | null>(null)
  const [episodePosterFile, setEpisodePosterFile] = useState<File | null>(null)
  const [episodeVideoUrl, setEpisodeVideoUrl] = useState('')
  const [episodePosterUrl, setEpisodePosterUrl] = useState('')
  const [dubTargetType, setDubTargetType] = useState('movie')
  const [dubMovieId, setDubMovieId] = useState('')
  const [dubSeriesId, setDubSeriesId] = useState('')
  const [dubSeasonId, setDubSeasonId] = useState('')
  const [dubEpisodeId, setDubEpisodeId] = useState('')
  const [dubSeasons, setDubSeasons] = useState<Season[]>([])
  const [dubEpisodes, setDubEpisodes] = useState<Episode[]>([])
  const [audioTracks, setAudioTracks] = useState<AudioTrack[]>([])
  const [audioLanguageCode, setAudioLanguageCode] = useState('hi')
  const [audioLanguageName, setAudioLanguageName] = useState('Hindi')
  const [audioUrl, setAudioUrl] = useState('')
  const [audioFile, setAudioFile] = useState<File | null>(null)




  async function loadSupportTickets() {
    setSupportLoading(true)
    const { data, error } = await supabase
      .from('support_tickets')
      .select('*')
      .order('created_at', { ascending: false })

    if (error) setMessage('Support Inbox: ' + error.message)
    else setTickets(data || [])
    setSupportLoading(false)
  }

  async function sendSupportReply(ticket: any) {
    const reply = (replies[ticket.id] || '').trim()
    if (!reply) {
      setMessage('पहले जवाब लिखें।')
      return
    }

    setSupportLoading(true)
    const { error } = await supabase
      .from('support_tickets')
      .update({ admin_reply: reply, status: 'answered' })
      .eq('id', ticket.id)

    if (error) setMessage(error.message)
    else {
      setMessage('जवाब यूज़र को भेज दिया गया।')
      setReplies(old => ({ ...old, [ticket.id]: '' }))
      await loadSupportTickets()
    }
    setSupportLoading(false)
  }

  async function closeSupportTicket(ticket: any) {
    setSupportLoading(true)
    const { error } = await supabase
      .from('support_tickets')
      .update({ status: 'closed' })
      .eq('id', ticket.id)

    if (error) setMessage(error.message)
    else {
      setMessage('Support request closed.')
      await loadSupportTickets()
    }
    setSupportLoading(false)
  }

  async function loadMovies() {
    setLoading(true)
    const { data, error } = await supabase
      .from('content')
      .select('*')
      .order('created_at', { ascending: false })

    if (error) setMessage(error.message)
    else setMovies(data || [])
    setLoading(false)
  }


  async function loadSeasons() {
    const { data, error } = await supabase
      .from('seasons')
      .select('*')
      .eq('content_id', selectedSeriesId)
      .order('season_number', { ascending: true })

    if (error) {
      setMessage('Season load error: ' + error.message)
      return
    }

    const rows = (data || []) as Season[]
    setSeasons(rows)
    setSelectedSeasonId(current =>
      rows.some(item => item.id === current) ? current : rows[0]?.id || ''
    )
  }

  async function loadEpisodes() {
    if (!selectedSeasonId) {
      setEpisodes([])
      return
    }

    const { data, error } = await supabase
      .from('episodes')
      .select('*')
      .eq('season_id', selectedSeasonId)
      .order('episode_number', { ascending: true })

    if (error) {
      setMessage('Episode load error: ' + error.message)
      return
    }
    setEpisodes((data || []) as Episode[])
  }

  async function saveSeason() {
    if (!selectedSeriesId || !seasonTitle.trim() || Number(seasonNumber) < 1) {
      setMessage('Series, Season number और title भरें।')
      return
    }

    setSupportLoading(true)
    const values = {
      content_id: selectedSeriesId,
      season_number: Number(seasonNumber),
      title: seasonTitle.trim(),
    }

    const result = editingSeasonId
      ? await supabase.from('seasons').update(values).eq('id', editingSeasonId)
      : await supabase.from('seasons').insert(values)

    if (result.error) setMessage('Season save error: ' + result.error.message)
    else {
      setMessage('Season saved successfully.')
      setSeasonTitle('')
      setSeasonNumber(String(seasons.length + 2))
      setEditingSeasonId(null)
      await loadSeasons()
    }
    setSupportLoading(false)
  }

  async function deleteSeason(season: Season) {
    if (!window.confirm(`Delete ${season.title} and all its episodes?`)) return

    setSupportLoading(true)
    const { error: episodeError } = await supabase
      .from('episodes')
      .delete()
      .eq('season_id', season.id)

    if (episodeError) {
      setMessage('Episode delete error: ' + episodeError.message)
      setSupportLoading(false)
      return
    }

    const { error } = await supabase.from('seasons').delete().eq('id', season.id)
    if (error) setMessage('Season delete error: ' + error.message)
    else {
      setMessage('Season deleted.')
      if (editingSeasonId === season.id) {
        setEditingSeasonId(null)
        setSeasonTitle('')
      }
      await loadSeasons()
    }
    setSupportLoading(false)
  }

  async function saveEpisode() {
    if (!selectedSeasonId || !episodeTitle.trim() || Number(episodeNumber) < 1) {
      setMessage('Episode number और title भरें।')
      return
    }

    if (episodeDuration && Number(episodeDuration) < 1) {
      setMessage('Duration सही भरें।')
      return
    }

    if (episodeVideoFile && (!episodeVideoFile.type.startsWith('video/') || episodeVideoFile.size > 50 * 1024 * 1024)) {
      setMessage('Video file सही चुनें। Maximum size 50 MB है।')
      return
    }

    if (episodePosterFile && (!episodePosterFile.type.startsWith('image/') || episodePosterFile.size > 5 * 1024 * 1024)) {
      setMessage('Poster image सही चुनें। Maximum size 5 MB है।')
      return
    }

    setSupportLoading(true)
    setMessage('')

    let videoUrl = episodeVideoUrl.trim() || null
    let posterUrl = episodePosterUrl.trim() || null

    if (episodeVideoFile) {
      const safeName = episodeVideoFile.name.replace(/[^a-zA-Z0-9._-]/g, '-')
      const filePath = `episodes/${Date.now()}-${safeName}`
      const { error } = await supabase.storage
        .from('Movie-Videos')
        .upload(filePath, episodeVideoFile, { contentType: episodeVideoFile.type })

      if (error) {
        setMessage('Episode video upload error: ' + error.message)
        setSupportLoading(false)
        return
      }

      videoUrl = supabase.storage.from('Movie-Videos').getPublicUrl(filePath).data.publicUrl
    }

    if (episodePosterFile) {
      const safeName = episodePosterFile.name.replace(/[^a-zA-Z0-9._-]/g, '-')
      const filePath = `episodes/${Date.now()}-${safeName}`
      const { error } = await supabase.storage
        .from('Movie-Posters')
        .upload(filePath, episodePosterFile, { contentType: episodePosterFile.type })

      if (error) {
        setMessage('Episode poster upload error: ' + error.message)
        setSupportLoading(false)
        return
      }

      posterUrl = supabase.storage.from('Movie-Posters').getPublicUrl(filePath).data.publicUrl
    }

    const values = {
      season_id: selectedSeasonId,
      episode_number: Number(episodeNumber),
      title: episodeTitle.trim(),
      description: episodeDescription.trim() || null,
      duration_minutes: episodeDuration ? Number(episodeDuration) : null,
      video_url: videoUrl,
      poster_url: posterUrl,
    }

    const result = editingEpisodeId
      ? await supabase.from('episodes').update(values).eq('id', editingEpisodeId)
      : await supabase.from('episodes').insert(values)

    if (result.error) {
      setMessage('Episode save error: ' + result.error.message)
    } else {
      setMessage('Episode saved successfully.')
      setEpisodeTitle('')
      setEpisodeDescription('')
      setEpisodeDuration('')
      setEpisodeNumber(String(episodes.length + 2))
      setEpisodeVideoUrl('')
      setEpisodePosterUrl('')
      setEpisodeVideoFile(null)
      setEpisodePosterFile(null)
      setEditingEpisodeId(null)
      await loadEpisodes()
    }
    setSupportLoading(false)
  }

  async function toggleEpisodePublish(episode: Episode) {
    if (!episode.is_published && !episode.video_url) {
      setMessage('Publish करने से पहले Episode का Video URL या Video upload करें।')
      return
    }

    setSupportLoading(true)
    const { error } = await supabase
      .from('episodes')
      .update({ is_published: !episode.is_published })
      .eq('id', episode.id)

    if (error) setMessage('Publish status error: ' + error.message)
    else {
      setMessage(episode.is_published ? 'Episode unpublished.' : 'Episode published.')
      await loadEpisodes()
    }
    setSupportLoading(false)
  }

  async function deleteEpisode(episode: Episode) {
    if (!window.confirm(`Delete episode "${episode.title}"?`)) return

    setSupportLoading(true)
    const { error } = await supabase.from('episodes').delete().eq('id', episode.id)
    if (error) setMessage('Episode delete error: ' + error.message)
    else {
      setMessage('Episode deleted.')
      await loadEpisodes()
    }
    setSupportLoading(false)
  }


  async function loadDubbingSeasons(seriesId: string) {
    setDubSeriesId(seriesId)
    setDubSeasonId('')
    setDubEpisodeId('')
    setDubSeasons([])
    setDubEpisodes([])
    if (!seriesId) return
    const { data, error } = await supabase.from('seasons').select('*')
      .eq('content_id', seriesId).order('season_number')
    if (error) setMessage('Season load error: ' + error.message)
    else {
      const rows = (data || []) as Season[]
      setDubSeasons(rows)
      if (rows[0]) await loadDubbingEpisodes(rows[0].id)
    }
  }

  async function loadDubbingEpisodes(seasonId: string) {
    setDubSeasonId(seasonId)
    setDubEpisodeId('')
    setDubEpisodes([])
    if (!seasonId) return
    const { data, error } = await supabase.from('episodes').select('*')
      .eq('season_id', seasonId).order('episode_number')
    if (error) setMessage('Episode load error: ' + error.message)
    else setDubEpisodes((data || []) as Episode[])
  }

  async function loadAudioTracks() {
    const targetId = dubTargetType === 'movie' ? dubMovieId : dubEpisodeId
    if (!targetId) { setAudioTracks([]); return }
    let query = supabase.from('audio_tracks').select('*')
    query = dubTargetType === 'movie'
      ? query.eq('content_id', targetId)
      : query.eq('episode_id', targetId)
    const { data, error } = await query.order('created_at', { ascending: false })
    if (error) setMessage('Audio load error: ' + error.message)
    else setAudioTracks((data || []) as AudioTrack[])
  }

  async function saveAudioTrack() {
    const targetId = dubTargetType === 'movie' ? dubMovieId : dubEpisodeId
    if (!targetId || !audioLanguageCode.trim() || !audioLanguageName.trim()) {
      setMessage('Video/Episode aur language select karein.')
      return
    }
    if (!audioFile && !audioUrl.trim()) {
      setMessage('Audio file upload karein ya Audio URL daalein.')
      return
    }
    if (audioFile && (!audioFile.type.startsWith('audio/') || audioFile.size > 50 * 1024 * 1024)) {
      setMessage('Valid audio file select karein. Maximum 50 MB.')
      return
    }

    setSupportLoading(true)
    setMessage('')
    let finalUrl = audioUrl.trim()
    if (audioFile) {
      const safeName = audioFile.name.replace(/[^a-zA-Z0-9._-]/g, '-')
      const path = `dubbing/${Date.now()}-${safeName}`
      const { error } = await supabase.storage.from('NEXORA-Audio')
        .upload(path, audioFile, { contentType: audioFile.type })
      if (error) {
        setMessage('Audio upload error: ' + error.message)
        setSupportLoading(false)
        return
      }
      finalUrl = supabase.storage.from('NEXORA-Audio').getPublicUrl(path).data.publicUrl
    }

    const values = {
      content_id: dubTargetType === 'movie' ? targetId : null,
      episode_id: dubTargetType === 'episode' ? targetId : null,
      language_code: audioLanguageCode.trim().toLowerCase(),
      language_name: audioLanguageName.trim(),
      audio_url: finalUrl,
      source_type: 'admin',
      is_published: false
    }
    const { error } = await supabase.from('audio_tracks').insert(values)
    if (error) setMessage('Audio save error: ' + error.message)
    else {
      setMessage('Audio saved. Publish it when ready.')
      setAudioFile(null)
      setAudioUrl('')
      await loadAudioTracks()
    }
    setSupportLoading(false)
  }

  async function toggleAudioPublish(track: AudioTrack) {
    setSupportLoading(true)
    const { error } = await supabase.from('audio_tracks')
      .update({ is_published: !track.is_published }).eq('id', track.id)
    if (error) setMessage('Publish error: ' + error.message)
    else {
      setMessage(track.is_published ? 'Dubbing unpublished.' : 'Dubbing published.')
      await loadAudioTracks()
    }
    setSupportLoading(false)
  }

  async function deleteAudioTrack(track: AudioTrack) {
    if (!window.confirm(`Delete ${track.language_name} dubbing?`)) return
    setSupportLoading(true)
    const { error } = await supabase.from('audio_tracks').delete().eq('id', track.id)
    if (error) setMessage('Delete error: ' + error.message)
    else { setMessage('Dubbing deleted.'); await loadAudioTracks() }
    setSupportLoading(false)
  }

  useEffect(() => {
    loadMovies()
    loadSupportTickets()
  }, [])

  function updateField(field: string, value: string) {
    setForm(old => ({ ...old, [field]: value }))
  }

  async function saveMovie(e: React.FormEvent) {
    e.preventDefault()
    setLoading(true)
    setMessage('')

    let posterUrl = form.poster_url.trim() || null

    if (posterFile) {
      if (!posterFile.type.startsWith('image/')) {
        setMessage('कृपया केवल Image चुनें।')
        setLoading(false)
        return
      }
      if (posterFile.size > 5 * 1024 * 1024) {
        setMessage('Poster का आकार 5 MB से कम होना चाहिए।')
        setLoading(false)
        return
      }

      const safeName = posterFile.name.replace(/[^a-zA-Z0-9._-]/g, '-')
      const filePath = `${Date.now()}-${safeName}`
      const { error: uploadError } = await supabase.storage
        .from('Movie-Posters')
        .upload(filePath, posterFile)

      if (uploadError) {
        setMessage('Poster upload error: ' + uploadError.message)
        setLoading(false)
        return
      }

      const { data: publicData } = supabase.storage
        .from('Movie-Posters')
        .getPublicUrl(filePath)
      posterUrl = publicData.publicUrl
    }

    let videoUrl = form.video_url.trim() || null

    if (videoFile) {
      if (!videoFile.type.startsWith('video/')) {
        setMessage('कृपया केवल Video file चुनें।')
        setLoading(false)
        return
      }
      if (videoFile.size > 50 * 1024 * 1024) {
        setMessage('Video का आकार 50 MB से कम होना चाहिए।')
        setLoading(false)
        return
      }

      const safeName = videoFile.name.replace(/[^a-zA-Z0-9._-]/g, '-')
      const filePath = `${Date.now()}-${safeName}`
      const { error: videoUploadError } = await supabase.storage
        .from('Movie-Videos')
        .upload(filePath, videoFile, { contentType: videoFile.type })

      if (videoUploadError) {
        setMessage('Video upload error: ' + videoUploadError.message)
        setLoading(false)
        return
      }

      const { data: videoPublicData } = supabase.storage
        .from('Movie-Videos')
        .getPublicUrl(filePath)
      videoUrl = videoPublicData.publicUrl
    }

    const record = {
      title: form.title.trim(),
      slug: form.slug.trim(),
      description: form.description.trim() || null,
      poster_url: posterUrl,
      video_url: videoUrl,
      release_year: form.release_year ? Number(form.release_year) : null,
      content_type: form.content_type,
      original_language: form.original_language.trim() || null,
      maturity_rating: form.maturity_rating || null,
      duration_minutes: form.duration_minutes ? Number(form.duration_minutes) : null,
      backdrop_url: form.backdrop_url.trim() || null,
    }

    const result = editingId
      ? await supabase.from('content').update(record).eq('id', editingId)
      : await supabase.from('content').insert(record)

    if (result.error) {
      setMessage(result.error.message)
    } else {
      setMessage(editingId ? 'Content updated!' : 'Content added!')
      setForm(emptyForm)
      setPosterFile(null)
      setVideoFile(null)
      setEditingId(null)
      await loadMovies()
      setActiveTab('Content Library')
    }

    setLoading(false)
  }

  function editMovie(movie: Movie) {
    setEditingId(movie.id)
    setForm({
      title: movie.title,
      slug: movie.slug,
      description: movie.description || '',
      poster_url: movie.poster_url || '',
      video_url: movie.video_url || '',
      release_year: movie.release_year?.toString() || '',
      content_type: movie.content_type,
      original_language: movie.original_language || '',
      maturity_rating: movie.maturity_rating || 'U/A 13+',
      duration_minutes: movie.duration_minutes?.toString() || '',
      backdrop_url: movie.backdrop_url || '',
    })
    setPosterFile(null)
    setVideoFile(null)
    setActiveTab('Content Studio')
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  async function togglePublish(movie: Movie) {
    const nextPublished = !movie.is_published
    if (nextPublished && !movie.rights_verified) {
      setMessage('पहले वास्तविक वितरण अधिकार सत्यापित करें।')
      return
    }

    const { error } = await supabase
      .from('content')
      .update({ is_published: nextPublished })
      .eq('id', movie.id)

    if (error) setMessage(error.message)
    else {
      setMessage(nextPublished ? 'Content published!' : 'Content unpublished!')
      await loadMovies()
    }
  }

  async function deleteMovie(id: string) {
    if (!window.confirm('क्या आप इस कंटेंट को डिलीट करना चाहते हैं?')) return

    const { error } = await supabase.from('content').delete().eq('id', id)
    if (error) setMessage(error.message)
    else {
      setMessage('Content deleted!')
      await loadMovies()
    }
  }

  async function toggleRights(movie: Movie) {
    const nextValue = !movie.rights_verified
    if (nextValue && !window.confirm('क्या आपके पास इस कंटेंट के स्ट्रीमिंग और वितरण अधिकार वास्तव में हैं?')) return

    const { error } = await supabase
      .from('content')
      .update({
        rights_verified: nextValue,
        is_published: nextValue ? movie.is_published : false,
      })
      .eq('id', movie.id)

    if (error) setMessage(error.message)
    else {
      setMessage('Rights status updated.')
      await loadMovies()
    }
  }

  const filteredMovies = useMemo(() => {
    const term = search.trim().toLowerCase()
    if (!term) return movies
    return movies.filter(movie =>
      movie.title.toLowerCase().includes(term) ||
      movie.content_type.toLowerCase().includes(term)
    )
  }, [movies, search])

  const published = movies.filter(item => item.is_published).length
  const pending = movies.filter(item => !item.is_published).length
  const series = movies.filter(item => item.content_type === 'series').length
  const openTickets = tickets.filter(item => item.status !== 'closed').length

  function goTo(tab: string) {
    setActiveTab(tab)
    setMessage('')
    if (tab === 'Content Studio' && !editingId) {
      setForm(emptyForm)
      setPosterFile(null)
      setVideoFile(null)
    }
  }

  return (
    <div className="nx-studio">
      <aside className="nx-studio-sidebar">
        <div className="nx-studio-brand">
          <span className="nx-studio-symbol">N</span>
          <div>NEXORA<span>+</span><small>STUDIO</small></div>
        </div>

        <div className="nx-studio-workspace">
