                  }}>
                    <option value="">Choose an episode</option>
                    {dubEpisodes.map(ep => (
                      <option key={ep.id} value={ep.id}>
                        Episode {ep.episode_number} — {ep.title}
                      </option>
                    ))}
                  </select>
                </>
              )}

              <button
                className="nx-studio-primary-button"
                disabled={supportLoading || (dubTargetType === 'movie' ? !dubMovieId : !dubEpisodeId)}
                onClick={() => void loadAudioTracks()}
              >
                Load Audio Tracks
              </button>
            </section>

            <section className="nx-studio-placeholder" style={{textAlign:'left',marginTop:20}}>
              <h2>2. Add Language Audio</h2>
              <p>Upload an already dubbed audio file or provide its public URL.</p>

              <label>Language Name</label>
              <input value={audioLanguageName} onChange={e => setAudioLanguageName(e.target.value)} placeholder="e.g. Hindi" />

              <label>Language Code</label>
              <input value={audioLanguageCode} onChange={e => setAudioLanguageCode(e.target.value)} placeholder="e.g. hi, en, ar" />

              <label>Audio File (Max 50 MB)</label>
              <input type="file" accept="audio/*" onChange={e => setAudioFile(e.target.files?.[0] || null)} />

              <label>Or Audio URL</label>
              <input value={audioUrl} onChange={e => setAudioUrl(e.target.value)} placeholder="https://example.com/audio.mp3" />

              <button
                className="nx-studio-primary-button"
                disabled={supportLoading || (dubTargetType === 'movie' ? !dubMovieId : !dubEpisodeId)}
                onClick={() => void saveAudioTrack()}
              >
                {supportLoading ? 'Please wait...' : '＋ Save Audio Track'}
              </button>
            </section>

            <section className="nx-studio-placeholder" style={{textAlign:'left',marginTop:20}}>
              <h2>3. Manage Audio Tracks</h2>
              {audioTracks.length === 0 ? (
                <p>No audio tracks loaded. Select content and tap Load Audio Tracks.</p>
              ) : audioTracks.map(track => (
                <article key={track.id} style={{padding:'14px 0',borderBottom:'1px solid #333'}}>
                  <strong>{track.language_name}</strong>
                  <p>{track.language_code} · {track.source_type.toUpperCase()} · {track.is_published ? 'Published' : 'Draft'}</p>
                  <button
                    className="nx-studio-primary-button"
                    disabled={supportLoading}
                    onClick={() => void toggleAudioPublish(track)}
                  >
                    {track.is_published ? 'Unpublish' : 'Publish'}
                  </button>
                  <button
                    className="nx-studio-text-button"
                    disabled={supportLoading}
                    onClick={() => {
                      if (window.confirm('Delete this audio track?')) void deleteAudioTrack(track);
                    }}
                  >
                    Delete
                  </button>
                </article>
              ))}
            </section>
          </>
        )}

        {activeTab === 'Analytics' && (
          <>
            <section className="nx-studio-heading"><div><span className="nx-studio-eyebrow">PLATFORM INSIGHTS</span><h1>Analytics</h1><p>Understand your platform performance.</p></div></section>
            <div className="nx-studio-placeholder"><span>▥</span><h2>Analytics data not connected</h2><p>Views, watch time, active users and revenue are not currently tracked in the available dashboard data. We will connect real analytics rather than display invented numbers.</p></div>
          </>
        )}

        {activeTab === 'Users' && (
          <>
            <section className="nx-studio-heading"><div><span className="nx-studio-eyebrow">ACCOUNT MANAGEMENT</span><h1>Users</h1><p>Manage platform accounts and access.</p></div></section>
            <div className="nx-studio-placeholder"><span>♙</span><h2>User management needs connection</h2><p>User profiles and role permissions need a dedicated secure management workflow. No user data is changed from this screen.</p></div>
          </>
        )}

        {activeTab === 'Subscriptions' && (
          <>
            <section className="nx-studio-heading"><div><span className="nx-studio-eyebrow">MEMBERSHIP MANAGEMENT</span><h1>Subscriptions</h1><p>Manage plans, memberships and payments.</p></div></section>
            <div className="nx-studio-placeholder"><span>◇</span><h2>Subscription system not connected</h2><p>Plans, payment history and active subscriptions need a payment provider and subscription database before they can be managed here.</p></div>
          </>
        )}

        {activeTab === 'Settings' && (
          <>
            <section className="nx-studio-heading"><div><span className="nx-studio-eyebrow">WORKSPACE CONFIGURATION</span><h1>Settings</h1><p>Platform configuration and administration.</p></div></section>
            <div className="nx-studio-placeholder"><span>⚙</span><h2>Studio settings</h2><p>Security, admin permissions, localization and platform configuration will be connected in the next development phase.</p></div>
          </>
        )}
      </main>
    </div>
  )
}
