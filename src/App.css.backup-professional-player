/* NEXORA+ ANIMATED WAVE NAVIGATION */


/* NEXORA+ TRUE WAVE BOTTOM NAVIGATION */

.nx-bottom-nav {
  overflow: visible;
  isolation: isolate;
  background: linear-gradient(145deg, #171720, #09090f);
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 30px;
  padding: 9px;
  box-shadow: 0 14px 40px #000b, inset 0 1px 0 #ffffff18;
}

.nx-bottom-nav button {
  position: relative;
  isolation: isolate;
  overflow: visible;
  border-radius: 20px;
  min-height: 62px;
  gap: 5px;
  background: transparent;
  transition: color .3s ease, transform .3s ease;
}

.nx-bottom-nav button.active {
  color: #fff;
  background: transparent;
  box-shadow: none;
  animation: nx-wave-float 2.8s ease-in-out infinite;
}

.nx-bottom-nav button.active::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 7px 5px 2px;
  border-radius: 0 0 22px 22px;
  background: linear-gradient(160deg, #e92358, #941338 72%, #65102e);
  clip-path: polygon(
    0 17%, 12% 10%, 25% 13%, 38% 24%,
    50% 28%, 62% 24%, 75% 13%, 88% 10%,
    100% 17%, 100% 100%, 0 100%
  );
  filter: drop-shadow(0 5px 15px #ed245766);
  animation: nx-wave-shape 3s ease-in-out infinite;
}

.nx-bottom-nav button.active::after {
  content: "";
  position: absolute;
  z-index: -1;
  top: 8px;
  left: 15%;
  width: 70%;
  height: 3px;
  border-radius: 50%;
  background: #ff8ba7;
  box-shadow: 0 0 10px #ff315e, 0 0 20px #ff315e;
  animation: nx-wave-light 2s ease-in-out infinite;
}

.nx-bottom-nav .nav-icon {
  font-size: 25px;
  line-height: 28px;
  position: relative;
  z-index: 1;
}

.nx-bottom-nav .nav-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .2px;
  position: relative;
  z-index: 1;
}

@keyframes nx-wave-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-2px); }
}

@keyframes nx-wave-shape {
  0%, 100% { filter: drop-shadow(0 5px 12px #ed245744); }
  50% { filter: drop-shadow(0 7px 20px #ed245799); }
}

@keyframes nx-wave-light {
  0%, 100% { transform: scaleX(.8); opacity: .75; }
  50% { transform: scaleX(1.08); opacity: 1; }
}

@media(max-width:600px) {
  .nx-bottom-nav {
    width: calc(100% - 24px);
    min-height: 76px;
    padding: 8px;
    border-radius: 25px;
  }
  .nx-bottom-nav button {
    min-height: 60px;
    border-radius: 18px;
  }
  .nx-bottom-nav .nav-icon { font-size: 23px; }
  .nx-bottom-nav .nav-label { font-size: 10px; }
}

@media(prefers-reduced-motion:reduce) {
  .nx-bottom-nav button.active,
  .nx-bottom-nav button.active::before,
  .nx-bottom-nav button.active::after {
    animation: none;
  }
}

