* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #080808;
  color: white;
  font-family: Arial, sans-serif;
}

.app {
  min-height: 100vh;
  background: #080808;
}

.navbar {
  min-height: 70px;
  padding: 18px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #080808;
}

.logo {
  font-size: 28px;
  font-weight: 900;
}

.logo span {
  color: #e50914;
}

.navbar nav {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.navbar a {
  color: #ddd;
  text-decoration: none;
}

.hero {
  min-height: 470px;
  display: flex;
  align-items: center;
  padding: 50px 7%;
  background:
    linear-gradient(90deg, #080808 5%, #080808aa 55%, transparent),
    linear-gradient(0deg, #080808, transparent 60%),
    url('https://image.tmdb.org/t/p/original/gEU2QniE6E77NI6lCU6MxlNBvIx.jpg') center/cover;
}

.hero-content {
  max-width: 550px;
}

.tagline {
  color: #e50914;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 3px;
  margin-bottom: 15px;
}

.hero h1 {
  font-size: clamp(42px, 8vw, 76px);
  line-height: 1.05;
  margin-bottom: 20px;
}

.hero-content > p:not(.tagline) {
  color: #ddd;
  line-height: 1.7;
  margin-bottom: 25px;
}

.explore {
  display: inline-block;
  background: #e50914;
  color: white;
  text-decoration: none;
  padding: 13px 24px;
  border-radius: 5px;
  font-weight: bold;
}

.catalog {
  padding: 40px 6%;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  margin-bottom: 25px;
}

.section-heading h2 {
  font-size: 27px;
}

.section-heading input {
  background: #191919;
  border: 1px solid #444;
  border-radius: 5px;
  color: white;
  padding: 12px;
  width: 220px;
}

.movie-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 18px;
}

.movie-card {
  background: #171717;
  border-radius: 8px;
  overflow: hidden;
  transition: transform .2s;
}

.movie-card:hover {
  transform: translateY(-5px);
}

.movie-card img {
  display: block;
  width: 100%;
  aspect-ratio: 2 / 3;
  object-fit: cover;
}

.movie-info {
  padding: 12px;
}

.movie-info h3 {
  font-size: 15px;
  margin-bottom: 7px;
}

.movie-info p {
  color: #aaa;
  font-size: 12px;
  margin-bottom: 12px;
}

.movie-info button {
  width: 100%;
  padding: 10px;
  border: 0;
  border-radius: 5px;
  background: #e50914;
  color: white;
  font-weight: bold;
}

footer {
  padding: 25px;
  text-align: center;
  color: #777;
  border-top: 1px solid #222;
}

@media (max-width: 600px) {
  .navbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
  }

  .navbar nav {
    gap: 14px;
  }

  .hero {
    min-height: 400px;
    padding: 30px 22px;
  }

  .catalog {
    padding: 30px 16px;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .section-heading input {
    width: 100%;
  }

  .movie-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
}

.auth-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  background:
    linear-gradient(#000c, #000e),
    url('https://image.tmdb.org/t/p/original/gEU2QniE6E77NI6lCU6MxlNBvIx.jpg') center/cover;
}

.auth-card {
  width: 100%;
  max-width: 420px;
  padding: 38px 30px;
  background: #141414;
  border: 1px solid #333;
  border-radius: 12px;
  text-align: center;
}

.auth-card .logo {
  margin-bottom: 30px;
  color: white;
}

.auth-card h1 {
  font-size: 28px;
  margin-bottom: 10px;
}

.auth-subtitle {
  color: #aaa;
  margin-bottom: 25px;
}

.auth-card form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.auth-card input {
  width: 100%;
  padding: 15px;
  background: #252525;
  border: 1px solid #444;
  border-radius: 6px;
  color: white;
  font-size: 15px;
}

.auth-card form button {
  padding: 15px;
  background: #e50914;
  color: white;
  border: 0;
  border-radius: 6px;
  font-size: 16px;
  font-weight: bold;
}

.auth-card button:disabled {
  opacity: .6;
}

.auth-message {
  color: #ddd;
  font-size: 13px;
  line-height: 1.5;
  margin-top: 18px;
}

.auth-switch {
  color: #aaa;
  margin-top: 25px;
  font-size: 14px;
}

.auth-switch button {
  background: none;
  border: 0;
  color: #e50914;
  font-weight: bold;
  margin-left: 7px;
  font-size: 14px;
}

/* NEXORA+ ADMIN PANEL */
.admin-panel {
  padding: 35px 6%;
  color: white;
  max-width: 1200px;
  margin: auto;
}

.admin-heading {
  margin-bottom: 28px;
}

.admin-heading h1 {
  font-size: 30px;
  margin-bottom: 8px;
}

.admin-heading p,
.admin-movie p {
  color: #aaa;
}

.admin-message {
  background: #242424;
  padding: 13px;
  border-radius: 8px;
  margin: 15px 0;
  color: #fff;
}

.admin-form {
  background: #171717;
  padding: 22px;
  border-radius: 12px;
  display: grid;
  gap: 14px;
  margin-bottom: 35px;
}

.admin-form h2,
.admin-list h2 {
  margin-bottom: 10px;
}

.admin-form input,
.admin-form textarea,
.admin-form select {
  width: 100%;
  padding: 13px;
  background: #292929;
  border: 1px solid #444;
  color: white;
  border-radius: 7px;
  font-size: 15px;
}

.admin-form textarea {
  min-height: 100px;
  resize: vertical;
}

.admin-panel button {
  padding: 11px 16px;
  background: #e50914;
  color: white;
  border: 0;
  border-radius: 6px;
  cursor: pointer;
}

.admin-panel button:disabled {
  opacity: .5;
}

.admin-movie {
  background: #171717;
  border: 1px solid #333;
  border-radius: 10px;
  padding: 18px;
  margin-top: 14px;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  align-items: center;
}

.admin-movie h3 {
  margin-bottom: 8px;
}

.admin-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

@media (max-width: 650px) {
  .admin-panel {
    padding: 25px 16px;
  }

  .admin-movie {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-actions {
    width: 100%;
  }

  .admin-actions button {
    flex: 1 1 40%;
  }

  .admin-heading h1 {
    font-size: 25px;
  }
}

/* NEXORA+ PREMIUM MOBILE DESIGN */

html {
  scroll-behavior: smooth;
}

body {
  overflow-x: hidden;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

.navbar {
  position: relative;
  z-index: 10;
  flex-wrap: wrap;
  gap: 18px;
  border-bottom: 1px solid #202020;
}

.logo {
  letter-spacing: -1px;
  font-size: 30px;
}

.navbar nav {
  align-items: center;
}

.navbar button {
  background: #e50914;
  color: white;
  border: 0;
  padding: 10px 14px;
  border-radius: 5px;
  font-weight: bold;
}

.hero {
  min-height: 520px;
  background-position: center;
}

.explore {
  transition: background .2s, transform .2s;
}

.explore:hover {
  background: #ff1824;
  transform: scale(1.04);
}

.movie-card {
  border: 1px solid #252525;
  box-shadow: 0 5px 20px #0005;
}

.movie-card img {
  cursor: pointer;
  transition: transform .3s;
}

.movie-card img:hover {
  transform: scale(1.04);
}

.movie-info button {
  cursor: pointer;
}

.movie-info button:active,
.navbar button:active {
  transform: scale(.97);
}

.catalog video {
  display: block;
  width: 100%;
  height: auto;
  max-height: 75vh;
  background: #000;
  object-fit: contain;
}

@media (max-width: 700px) {
  .navbar {
    padding: 16px 18px;
    gap: 12px;
  }

  .logo {
    font-size: 27px;
  }

  .navbar nav {
    width: 100%;
    gap: 12px;
    justify-content: flex-start;
  }

  .navbar nav a,
  .navbar nav button {
    font-size: 14px;
  }

  .hero {
    min-height: 470px;
    padding: 35px 20px;
    background-position: center;
  }

  .hero-content {
    max-width: 100%;
  }

  .hero h1 {
    font-size: clamp(38px, 10vw, 58px);
  }

  .hero-content > p:not(.tagline) {
    font-size: 16px;
  }

  .catalog {
    padding: 30px 16px;
  }

  .movie-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .movie-card {
    min-width: 0;
  }

  .movie-info {
    padding: 10px;
  }

  .movie-info h3 {
    font-size: 14px;
  }

  .catalog video {
    max-height: 55vh;
  }
}


/* MOVIE CARD ACTIONS */

.movie-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.movie-info .play-button {
  background: white;
  color: #111;
}

.movie-info .play-button:hover {
  background: #e50914;
  color: white;
}

.movie-info button {
  cursor: pointer;
  transition: .2s;
}


/* PREMIUM MOVIE DETAILS */

.movie-details {
  display: flex;
  align-items: center;
  gap: 35px;
  padding: 45px 6%;
  background: linear-gradient(110deg, #181818, #080808);
}

.details-poster {
  width: 260px;
  max-width: 40%;
  border-radius: 12px;
  box-shadow: 0 12px 35px #0009;
}

.details-content {
  max-width: 650px;
}

.details-content h1 {
  font-size: clamp(32px, 6vw, 58px);
  margin: 12px 0;
}

.details-meta {
  color: #aaa;
  margin-bottom: 18px;
}

.details-description {
  color: #ddd;
  line-height: 1.8;
  margin-bottom: 25px;
}

.details-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.details-actions button {
  padding: 13px 20px;
  border: 0;
  border-radius: 6px;
  background: #292929;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

.details-actions .watch-button {
  background: #e50914;
}

.player-section {
  padding: 30px 6% 55px;
}

.player-section h2 {
  margin-bottom: 20px;
}

.player-section video {
  display: block;
  width: 100%;
  max-height: 75vh;
  background: #000;
  border-radius: 12px;
}

@media (max-width: 600px) {
  .movie-details {
    flex-direction: column;
    align-items: flex-start;
    padding: 25px 18px;
    gap: 22px;
  }

  .details-poster {
    width: 100%;
    max-width: 280px;
  }

  .details-content h1 {
    font-size: 34px;
  }

  .details-actions {
    width: 100%;
  }

  .details-actions button {
    flex: 1;
  }

  .player-section {
    padding: 25px 16px 40px;
  }
}


/* NEXORA+ NETFLIX STYLE DETAILS PAGE */

.details-page {
  background: #080808;
  min-height: 100vh;
}

.details-page .player-section {
  padding: 0;
  background: #000;
}

.details-page .player-section h2 {
  display: none;
}

.details-page .player-section video {
  display: block;
  width: 100%;
  max-height: 75vh;
  aspect-ratio: 16 / 9;
  object-fit: contain;
  border-radius: 0;
  background: #000;
}

.details-page .movie-details {
  display: block;
  padding: 28px 5% 35px;
  background: linear-gradient(180deg, #181818, #080808);
}

.details-page .details-poster {
  display: none;
}

.details-page .details-content {
  max-width: 900px;
}

.details-page .details-content h1 {
  font-size: clamp(28px, 5vw, 46px);
  margin: 10px 0;
}

.details-page .details-description {
  color: #ccc;
  line-height: 1.7;
  font-size: 15px;
}

.more-like-this {
  padding: 10px 5% 45px;
}

.more-like-this h2 {
  font-size: 23px;
  margin-bottom: 20px;
}

.recommendation-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(135px, 1fr));
  gap: 16px;
}

.recommendation-card {
  min-width: 0;
  padding: 0;
  border: 0;
  background: #171717;
  color: white;
  text-align: left;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
}

.recommendation-card img,
.recommendation-placeholder {
  display: block;
  width: 100%;
  aspect-ratio: 2 / 3;
  object-fit: cover;
}

.recommendation-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #252525;
  color: #e50914;
  font-size: 20px;
  font-weight: bold;
}

.recommendation-card span,
.recommendation-card small {
  display: block;
  padding: 8px 9px 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommendation-card span {
  font-weight: bold;
}

.recommendation-card small {
  padding-top: 4px;
  padding-bottom: 10px;
  color: #aaa;
}

.recommendation-card:active {
  transform: scale(.97);
}

@media (max-width: 600px) {
  .details-page .player-section video {
    max-height: 40vh;
  }

  .details-page .movie-details {
    padding: 22px 18px 28px;
  }

  .more-like-this {
    padding: 5px 18px 35px;
  }

  .recommendation-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
}


/* NEXORA+ NETFLIX INSPIRED HOME */
.netflix-home {
  min-height: 100vh;
  padding-bottom: 105px;
  background: radial-gradient(ellipse at top, #541719 0%, #17090a 38%, #080808 75%);
  overflow: hidden;
}

.nx-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 4%;
}

.nx-brand {
  font-size: 27px;
  font-weight: 900;
  letter-spacing: -1px;
}

.nx-brand > span {
  color: #e50914;
  font-size: 48px;
  vertical-align: middle;
  margin-right: 8px;
}

.nx-brand small { color: #e50914; }

.nx-header-actions {
  display: flex;
  gap: 10px;
}

.nx-header-actions button {
  background: #292020;
  color: white;
  border: 1px solid #614343;
  padding: 10px 14px;
  border-radius: 8px;
}

.nx-categories {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding: 5px 4% 20px;
  scrollbar-width: none;
}

.nx-categories button {
  flex: 1 1 0;
  min-width: 0;
  white-space: nowrap;
  color: #d7d7dc;
  background: #17171d;
  border: 1px solid #35353e;
  border-radius: 12px;
  padding: 14px 8px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .2px;
  cursor: pointer;
  transition: .2s ease;
}
.nx-categories button.active {
  color: #fff;
  background: linear-gradient(135deg, #a91535, #68152b);
  border-color: #d12b4e;
  box-shadow: 0 5px 18px #a9153540;
}

.nx-hero {
  min-height: 570px;
  margin: 8px 4% 35px;
  border: 1px solid #865252;
  border-radius: 23px;
  background-color: #501010;
  background-size: cover;
  background-position: center top;
  display: flex;
  align-items: flex-end;
  box-shadow: 0 15px 45px #0008;
}

.nx-hero-content {
  padding: 28px;
  width: 100%;
  background: linear-gradient(0deg,#090909 0%,#090909dd 45%,transparent 100%);
  border-radius: 22px;
}

.nx-original {
  color: #ff303b;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 3px;
}

.nx-hero h1 {
  font-size: clamp(30px, 7vw, 55px);
  margin: 12px 0;
}

.nx-hero p {
  color: #ddd;
  line-height: 1.5;
  max-width: 520px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.nx-hero-buttons {
  display: flex;
  gap: 12px;
  margin-top: 22px;
}

.nx-hero-buttons button {
  flex: 1;
  border: 0;
  border-radius: 9px;
  padding: 15px 10px;
  font-weight: bold;
  font-size: 16px;
}

.nx-play { background: white; color: black; }
.nx-list { background: #554849; color: white; }

.nx-row-section {
  padding: 12px 4% 28px;
}

.nx-section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.nx-section-title h2 { font-size: 22px; }
.nx-section-title span { color: #bbb; font-size: 13px; }

.nx-movie-row {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 12px;
}

.nx-movie-card {
  flex: 0 0 145px;
  min-width: 0;
  position: relative;
  padding: 0;
  background: #191919;
  color: white;
  border: 0;
  border-radius: 9px;
  overflow: hidden;
  text-align: left;
}

.nx-movie-card img,
.nx-poster-placeholder {
  width: 100%;
  aspect-ratio: 2 / 3;
  object-fit: cover;
  display: block;
}

.nx-poster-placeholder {
  background: #302020;
  display: grid;
  place-items: center;
  color: #ed1b2a;
  font-weight: bold;
}

.nx-movie-card > span,
.nx-movie-card > small {
  display: block;
  padding: 8px 8px 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nx-movie-card > span { font-weight: bold; }
.nx-movie-card > small { color: #aaa; padding-bottom: 10px; }

.nx-top-badge {
  position: absolute;
  top: 8px;
  left: 7px;
  background: #e50914;
  padding: 5px;
  border-radius: 4px;
  font-size: 10px;
}

.nx-empty {
  color: #aaa;
  padding: 15px 4%;
}

.nx-search-section { padding: 20px 4%; }
.nx-search-section input {
  width: 100%;
  padding: 14px;
  border-radius: 9px;
  border: 1px solid #555;
  background: #202020;
  color: white;
}

.nx-bottom-nav {
  position: fixed;
  z-index: 100;
  bottom: 18px;
  left: 50%;
  transform: translateX(-50%);
  width: min(92%, 580px);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 13px 8px;
  background: #252525f2;
  border: 1px solid #555;
  border-radius: 45px;
  box-shadow: 0 8px 35px #000b;
}

.nx-bottom-nav a,
.nx-bottom-nav button {
  color: #ddd;
  text-decoration: none;
  background: transparent;
  border: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  font-size: 24px;
  min-width: 55px;
}

.nx-bottom-nav span {
  font-size: 12px;
}

.nx-bottom-nav a:first-child { color: white; }

@media (max-width: 600px) {
  .nx-header { padding: 13px 18px; }
  .nx-brand { font-size: 23px; }
  .nx-brand > span { font-size: 42px; }
  .nx-header-actions button { padding: 8px 10px; }
  .nx-categories { padding-left: 18px; }
  .nx-categories button { padding: 13px 5px; font-size: 12px; }
  .nx-hero {
    min-height: 590px;
    margin: 5px 18px 28px;
    background-position: center top;
  }
  .nx-hero-content { padding: 18px; }
  .nx-hero h1 { font-size: 34px; }
  .nx-row-section { padding-left: 18px; padding-right: 0; }
  .nx-section-title { padding-right: 18px; }
  .nx-movie-card { flex-basis: 145px; }
}


