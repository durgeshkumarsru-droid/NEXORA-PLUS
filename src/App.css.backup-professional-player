/* Premium fixed bottom navigation */
.nx-bottom-nav{
  position:fixed;
  z-index:1000;
  left:50%;
  bottom:max(12px, env(safe-area-inset-bottom));
  transform:translateX(-50%);
  width:min(94%,560px);
  min-height:70px;
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  align-items:center;
  padding:7px 9px;
  background:rgba(17,17,23,.96);
  border:1px solid #393943;
  border-radius:22px;
  box-shadow:0 10px 38px #000b, inset 0 1px 0 #ffffff12;
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}
.nx-bottom-nav button{
  position:relative;
  min-width:0;
  min-height:54px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  gap:3px;
  padding:5px 2px;
  border:0;
  border-radius:15px;
  color:#9999a6;
  background:transparent;
  cursor:pointer;
  transition:background .2s ease,color .2s ease,transform .2s ease;
  -webkit-tap-highlight-color:transparent;
}
.nx-bottom-nav button:active{transform:scale(.94)}
.nx-bottom-nav .nav-icon{font-size:23px;line-height:25px;font-weight:600}
.nx-bottom-nav .nav-label{font-size:10px;line-height:14px;font-weight:600;white-space:nowrap}
.nx-bottom-nav button.active{
  color:#fff;
  background:linear-gradient(145deg,#8e1835,#501326);
  box-shadow:0 4px 15px #b51e423d;
}
.nx-bottom-nav button.active::after{
  content:"";
  position:absolute;
  bottom:3px;
  width:15px;
  height:2px;
  border-radius:5px;
  background:#ff6687;
}
.nx-bottom-nav button:focus-visible{outline:2px solid #ff6687;outline-offset:2px}
@media(max-width:600px){
  .nx-bottom-nav{width:calc(100% - 24px);bottom:max(10px,env(safe-area-inset-bottom));min-height:68px;border-radius:20px}
  .nx-bottom-nav .nav-icon{font-size:22px}
  .nx-bottom-nav .nav-label{font-size:10px}
}

